função local criarESP(plr)
	se plr == jogador então retorne fim
	função local aplicar(caractere)
		Se não for um caractere, retorne o fim.
		local oldH = char:FindFirstChild("AdminHighlight")
		se oldH então oldH:Destruir() fim
		local oldB = char:FindFirstChild("AdminName", true)
		se oldB então oldB:Destruir() fim

		local h = Instance.new("Destaque")
		h.Name = "AdminHighlight"
		h.FillColor = Color3.fromRGB(255, 50, 50)
		h.OutlineColor = Color3.fromRGB(255, 255, 255)
		h.FillTransparency = 0,55
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Parent = char

		raiz local = char:FindFirstChild("HumanoidRootPart")
		Se não for raiz, retorne fim.

		local b = Instance.new("BillboardGui")
		b.Nome = "Nome do Administrador"
		b.Size = UDim2.new(0, 200, 0, 40)
		b.StudsOffset = Vector3.new(0, 3.3, 0)
		b.AlwaysOnTop = verdadeiro
		b.Parent = raiz

		local t = Instance.new("TextLabel", b)
		t.Size = UDim2.new(1, 0, 1, 0)
		t.BackgroundTransparency = 1
		t.Texto = plr.Nome
		t.TextColor3 = Color3.new(1, 1, 1)
		t.TextStrokeTransparency = 0.4
		t.Font = Enum.Font.GothamBold
		t.TextSize = 15
	fim
	se plr.Character então aplicar(plr.Character) fim
	plr.CharacterAdded:Connect(apply)
fim

