local function tocarSom(id, volume)
	if not sonsAtivados then return end
	local som = Instance.new("Sound")
	som.SoundId = "rbxassetid://" .. tostring(id)
	som.Volume = volume or 0.5
	som.Parent = SoundService
	som:Play()
	som.Ended:Connect(function() som:Destroy() end)
end

