função local toggleFly()
	se freecam então retorne fim
	voando = não voando

	se estiver voando então
		bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		velocidadeDoCorpo.Velocidade = Vetor3.zero
		bodyVelocity.Parent = rootPart

		bodyGyro = Instance.new("BodyGyro")
		bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
		bodyGyro.P = 9000
		bodyGyro.Parent = rootPart

		humanoide.PlatformStand = verdadeiro

		flyConnection = RunService.RenderStepped:Connect(função()
			Se não estiver voando, não for rootPart ou não for rootPart.Parent, então retorne.
			câmera local = espaço de trabalho.CâmeraAtual
			movimento local = Vector3.zero
			velocidade local = velocidades[velocidadeAtual].valor

			Se UserInputService:IsKeyDown(Enum.KeyCode.W) então move += cam.CFrame.LookVector fim
			se UserInputService:IsKeyDown(Enum.KeyCode.S) então move -= cam.CFrame.LookVector fim
			se UserInputService:IsKeyDown(Enum.KeyCode.A) então move -= cam.CFrame.RightVector fim
			Se UserInputService:IsKeyDown(Enum.KeyCode.D) então move += cam.CFrame.RightVector fim
			Se UserInputService:IsKeyDown(Enum.KeyCode.Space) então move += Vector3.new(0, 1, 0) fim
			se UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) então move -= Vector3.new(0, 1, 0) fim

			Se move.Magnitude > 0 então move = move.Unit * speed fim
			velocidadeDoCorpo.Velocidade = movimento
			bodyGyro.CFrame = cam.CFrame
		fim)

		setState(FlyBtn, true, "Voar: LIGADO", "Voar: DESLIGADO", Color3.fromRGB(0, 140, 200))
		tocarSom(SOM_ON, 0.5)
	outro
		se flyConnection então flyConnection:Disconnect() flyConnection = nil fim
		se bodyVelocity então bodyVelocity:Destroy() bodyVelocity = nil fim
		se bodyGyro então bodyGyro:Destroy() bodyGyro = nil fim
