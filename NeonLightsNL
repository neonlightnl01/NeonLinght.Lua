função local tocarSom(id, volume)
	se não sonsAtivados então retorne fim
	local som = Instance.new("Som")
	som.SoundId = "rbxassetid://" .. tostring(id)
	som.Volume = volume ou 0,5
	som.Parent = SoundService
	som:Reproduzir()
	som.Ended:Connect(function() som:Destroy() end)
fim

