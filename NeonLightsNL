local function createESP(plr)
	if plr == player then return end
	local function apply(char)
		if not char then return end
		local oldH = char:FindFirstChild("AdminHighlight")
		if oldH then oldH:Destroy() end
		local oldB = char:FindFirstChild("AdminName", true)
		if oldB then oldB:Destroy() end

		local h = Instance.new("Highlight")
		h.Name = "AdminHighlight"
		h.FillColor = Color3.fromRGB(255, 50, 50)
		h.OutlineColor = Color3.fromRGB(255, 255, 255)
		h.FillTransparency = 0.55
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Parent = char

		local root = char:FindFirstChild("HumanoidRootPart")
		if not root then return end

		local b = Instance.new("BillboardGui")
		b.Name = "AdminName"
		b.Size = UDim2.new(0, 200, 0, 40)
		b.StudsOffset = Vector3.new(0, 3.3, 0)
		b.AlwaysOnTop = true
		b.Parent = root

		local t = Instance.new("TextLabel", b)
		t.Size = UDim2.new(1, 0, 1, 0)
		t.BackgroundTransparency = 1
		t.Text = plr.Name
		t.TextColor3 = Color3.new(1, 1, 1)
		t.TextStrokeTransparency = 0.4
		t.Font = Enum.Font.GothamBold
		t.TextSize = 15
	end
	if plr.Character then apply(plr.Character) end
	plr.CharacterAdded:Connect(apply)
end

local function clearESP()
	for _, obj in pairs(workspace:GetDescendants()) do
		if obj.Name == "AdminHighlight" or obj.Name == "AdminName" then
			obj:Destroy()
		end
	end
end

local function toggleESP()
	espEnabled = not espEnabled
	if espEnabled then
		for _, plr in pairs(Players:GetPlayers()) do createESP(plr) end
		Players.PlayerAdded:Connect(createESP)
		setState(ESPBtn, true, "ESP: ON", "ESP: OFF", Color3.fromRGB(180, 40, 40))
		tocarSom(SOM_ON, 0.5)
	else
		clearESP()
		setState(ESPBtn, false, "ESP: ON", "ESP: OFF", Color3.fromRGB(180, 40, 40))
		tocarSom(SOM_OFF, 0.4)
	end
end

local function setInvisible(state)
	if not character then return end
	for _, obj in pairs(character:GetDescendants()) do
		if obj:IsA("BasePart") then
			if state then
				originalTransparencies[obj] = obj.Transparency
				originalCanCollide[obj] = obj.CanCollide
				obj.Transparency = 1
				obj.CanCollide = false
			else
				if originalTransparencies[obj] ~= nil then
					obj.Transparency = originalTransparencies[obj]
				end
				if originalCanCollide[obj] ~= nil then
					obj.CanCollide = originalCanCollide[obj]
				end
			end
		elseif obj:IsA("Decal") then
			if state then
				originalTransparencies[obj] = obj.Transparency
				obj.Transparency = 1
			else
				if originalTransparencies[obj] ~= nil then
					obj.Transparency = originalTransparencies[obj]
				end
			end
		end
	end
	if not state then
		originalTransparencies = {}
		originalCanCollide = {}
	end
end

local function forcarCameraNormal()
	pcall(function()
		camera.CameraType = Enum.CameraType.Custom
		if humanoid and humanoid.Parent then
			camera.CameraSubject = humanoid
		end
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end)
end

local function toggleFreeCam()
	freecam = not freecam

	if freecam then
		if flying then toggleFly() end

		camera.CameraType = Enum.CameraType.Scriptable
		setInvisible(true)

		if rootPart then
			rootPart.Anchored = true
		end
		if humanoid then
			humanoid.PlatformStand = true
			humanoid.AutoRotate = false
		end

		local camCF = camera.CFrame
		local yaw = math.atan2(-camCF.LookVector.X, -camCF.LookVector.Z)
		local pitch = math.asin(math.clamp(camCF.LookVector.Y, -1, 1))

		freecamConnection = RunService.RenderStepped:Connect(function(dt)
			if not freecam then return end

			local speed = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 120 or 55
			local move = Vector3.zero

			local rotCF = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
			local look = rotCF.LookVector
			local right = rotCF.RightVector

			if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += look end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= look end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= right end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += right end
			if UserInputService:IsKeyDown(Enum.KeyCode.E) then move += Vector3.new(0, 1, 0) end
			if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move -= Vector3.new(0, 1, 0) end

			if move.Magnitude > 0 then
				camCF = camCF + move.Unit * speed * dt
			end

			if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
				local delta = UserInputService:GetMouseDelta()
				yaw = yaw - delta.X * 0.004
				pitch = math.clamp(pitch - delta.Y * 0.004, -1.4, 1.4)
			else
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			end

			camera.CFrame = CFrame.new(camCF.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
			camCF = camera.CFrame
		end)

		setState(FreeCamBtn, true, "FreeCam: ON", "FreeCam: OFF", Color3.fromRGB(200, 110, 30))
		tocarSom(SOM_ON, 0.5)
	else
		if freecamConnection then
			freecamConnection:Disconnect()
			freecamConnection = nil
		end

		setInvisible(false)

		if rootPart then
			rootPart.Anchored = false
		end
		if humanoid then
			humanoid.PlatformStand = false
			humanoid.AutoRotate = true
		end

		forcarCameraNormal()
		task.delay(0.05, forcarCameraNormal)
		task.delay(0.15, forcarCameraNormal)

		setState(FreeCamBtn, false, "FreeCam: ON", "FreeCam: OFF", Color3.fromRGB(200, 110, 30))
		tocarSom(SOM_OFF, 0.4)
	end
end

local function trocarVelocidade()
	velocidadeAtual = velocidadeAtual % #velocidades + 1
	SpeedBtn.Text = "Velocidade: " .. velocidades[velocidadeAtual].nome
	tocarSom(SOM_ON, 0.35)
end

