UserInputService.InputBegan:Connect(function(input, gp)
	se gp então retorne fim
	Se input.KeyCode == TECLA_HUB então
		alternarHub()
		retornar
	fim
	Se input.UserInputType == Enum.UserInputType.Touch então
		local agora = tick()
		se agora - últimoTempoDeToque <= TAP_WINDOW então
			contagemDeToques += 1
		outro
			contagemDeToques = 1
		fim
		últimoToque = agora
		se tapCount >= 3 então
			alternarHub()
			contagemDeToques = 0
		fim
	fim
fim)

