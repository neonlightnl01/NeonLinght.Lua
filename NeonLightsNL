função local setInvisible(estado)
	Se não for um caractere, retorne o fim.
	para _, obj em pares(caractere:ObterDescendentes()) faça
		se obj:IsA("BasePart") então
			se estado então
				originalTransparencies[obj] = obj.Transparência
				obj.Transparência = 1
				obj.CanCollide = false
			outro
				se originalTransparencies[obj] ~= nil então
					obj.Transparência = originalTransparencies[obj]
				fim
			fim
		senão se obj:IsA("Decalque") então
			se estado então
				originalTransparencies[obj] = obj.Transparência
				obj.Transparência = 1
			outro
				se originalTransparencies[obj] ~= nil então
					obj.Transparência = originalTransparencies[obj]
				fim
			fim
		fim
	fim
	se não especificar então
		transparênciasOriginal = {}
	fim
fim

