UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == TECLA_HUB then
		toggleHub()
		return
	end
	if input.UserInputType == Enum.UserInputType.Touch then
		local now = tick()
		if now - lastTapTime <= TAP_WINDOW then
			tapCount += 1
		else
			tapCount = 1
		end
		lastTapTime = now
		if tapCount >= 3 then
			toggleHub()
			tapCount = 0
		end
	end
end)

player.CharacterAdded:Connect(function()
	if freecam then
		freecam = false
		if freecamConnection then
			freecamConnection:Disconnect()
			freecamConnection = nil
		end
	end
	if flying then
		flying = false
		if flyConnection then flyConnection:Disconnect() end
		if bodyVelocity then bodyVelocity:Destroy() end
		if bodyGyro then bodyGyro:Destroy() end
	end

	task.wait(0.3)
	getChar()
	forcarCameraNormal()

	if humanoid then
		humanoid.WalkSpeed = walkSpeed
	end

	setState(FreeCamBtn, false, "FreeCam: ON", "FreeCam: OFF", Color3.fromRGB(200, 110, 30))
	setState(FlyBtn, false, "Fly: ON", "Fly: OFF", Color3.fromRGB(0, 140, 200))
end)

