função local toggleFreeCam()
	freecam = não freecam

	se for freecam então
		se estiver voando, então alterneFly() fim

		câmera.TipoCâmera = Enum.TipoCâmera.Scriptável
		definirInvisível(verdadeiro)
		se humanoide então
			humanoide.PlatformStand = verdadeiro
			humanoide.RotaçãoAutomática = falso
		fim

		local camCF = câmera.CFrame
		local yaw = math.atan2(-camCF.LookVector.X, -camCF.LookVector.Z)
		local pitch = math.asin(math.clamp(camCF.LookVector.Y, -1, 1))

		freecamConnection = RunService.RenderStepped:Connect(function(dt)
			Se não for freecam, retorne ao fim.

			velocidade local = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) e 120 ou 55
			movimento local = Vector3.zero

			local rotCF = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
			local look = rotCF.LookVector
			local direita = rotCF.VetorDireito

			se UserInputService:IsKeyDown(Enum.KeyCode.W) então mover += olhar fim
			se UserInputService:IsKeyDown(Enum.KeyCode.S) então mover -= olhar fim
			Se UserInputService:IsKeyDown(Enum.KeyCode.A) então mover -= direita fim
			se UserInputService:IsKeyDown(Enum.KeyCode.D) então mover += direita fim
			Se UserInputService:IsKeyDown(Enum.KeyCode.E) então move += Vector3.new(0, 1, 0) fim
			Se UserInputService:IsKeyDown(Enum.KeyCode.Q) então move -= Vector3.new(0, 1, 0) fim

			Se move.Magnitude > 0 então
				camCF = camCF + unidade de movimento * velocidade * dt
			fim

			se UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) então
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
				local delta = UserInputService:GetMouseDelta()
				guinada = guinada - delta.X * 0,004
				pitch = math.clamp(pitch - delta.Y * 0.004, -1.4, 1.4)
			outro
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			fim

			camera.CFrame = CFrame.new(camCF.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
			camCF = câmera.CFrame
		fim)

		setState(FreeCamBtn, true, "FreeCam: LIGADO", "FreeCam: DESLIGADO", Color3.fromRGB(200, 110, 30))
		tocarSom(SOM_ON, 0.5)
	outro
		se freecamConnection então
			freecamConnection:Desconectar()
			freecamConnection = nulo
		fim

		definirInvisível(falso)
		se humanoide então
			humanoide.PlatformStand = falso
			humanoide.RotaçãoAutomática = verdadeiro
		fim

		para câmera de carroNormal()
		tarefa.atraso(0.05, paraCâmeraNormal)

		setState(FreeCamBtn, false, "FreeCam: LIGADO", "FreeCam: DESLIGADO", Color3.fromRGB(200, 110, 30))
		tocarSom(SOM_OFF, 0.4)
	fim
fim

